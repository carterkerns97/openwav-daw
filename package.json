{
  "name": "openwave-daw",
  "version": "0.1.0",
  "description": "Open-source desktop and web digital audio workstation",
  "author": "Carter Kerns and Openwave contributors",
  "private": true,
  "main": "desktop/electron/main.cjs",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "desktop:dev": "concurrently -k \"pnpm dev\" \"wait-on http://localhost:3000 && cross-env OPENWAVE_DEV_URL=http://localhost:3000 electron desktop/electron/main.cjs\"",
    "desktop:renderer": "vite build --config desktop/vite.config.ts",
    "desktop:pack": "pnpm desktop:renderer && electron-builder --dir",
    "desktop:dist": "pnpm desktop:renderer && electron-builder",
    "native:configure": "cmake -S native -B native/build -DCMAKE_BUILD_TYPE=Release",
    "native:build": "cmake --build native/build --config Release",
    "native:test": "ctest --test-dir native/build -C Release --output-on-failure",
    "lint": "oxlint",
    "format": "oxfmt"
  },
  "build": {
    "appId": "com.openwave.daw",
    "productName": "Openwave",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/electron/**/*",
      "desktop-dist/renderer/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ]
    }
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@shadcn/react": "0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "embla-carousel-react": "8.5.2",
    "input-otp": "1.4.2",
    "lucide-react": "1.31.0",
    "react": "19.2.6",
    "react-day-picker": "9.8.1",
    "react-dom": "19.2.6",
    "react-resizable-panels": "4.5.8",
    "react-server-dom-webpack": "19.2.6",
    "recharts": "3.8.0",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "vinext": "1.0.0-beta.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "wait-on": "^9.5.1",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
